# Copy to .env and load it however you start the app (env vars are read directly).
EASYMODE_PORT=8787
EASYMODE_BIND=127.0.0.1
EASYMODE_DEFAULT_ROUTER=192.168.1.1
EASYMODE_ROUTER_SCHEME=http
EASYMODE_ROUTER_TIMEOUT_MS=8000
EASYMODE_SESSION_IDLE_MS=600000
EASYMODE_INTERNET_PROBE_HOST=1.1.1.1
# Only set this if the router is genuinely not on a private network.
# EASYMODE_ALLOW_PUBLIC_ROUTER=1
